# Copy to .env for local development. Never commit real values.

NODE_ENV=development
PORT=4000

# MongoDB connection string (a separate database from Serviqo's)
MONGODB_URI=mongodb://127.0.0.1:27017/bunty-store

# Signs the session cookie. At least 32 random characters.
SESSION_SECRET=

# The Serviqo connector (docs/serviqo-connector.md). Leave empty to keep it off.
# Each is at least 32 random characters, the two are different, and the same
# values go into Serviqo's connector settings for this store.
SERVIQO_CONNECTOR_SECRET=
SERVIQO_IDENTITY_SECRET=

# The Serviqo chat on every page. Both are public values, not secrets: the
# address of Serviqo (https://serviqo.live) and Bunty's widget key from
# Serviqo's Settings (starts with wk_). Leave empty to show no chat.
SERVIQO_URL=
SERVIQO_WIDGET_KEY=

# Email through Resend: order updates and "forgot password". Leave the key
# empty to send no email (the site then offers no password reset).
# EMAIL_FROM must be on a domain verified in Resend; PUBLIC_URL is this
# site's address, used for links in the emails.
RESEND_API_KEY=
EMAIL_FROM=Bunty Store <orders@bunty.me>
PUBLIC_URL=http://localhost:5180

# Optional: "Continue with Google". Create an OAuth client (Web application) in
# Google Cloud Console; its redirect URI is {PUBLIC_URL}/api/auth/google/callback.
# Needs PUBLIC_URL. Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used only by `npm run seed` to create the store admin and the sample customers.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
